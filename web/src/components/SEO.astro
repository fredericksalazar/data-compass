---
interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalURL?: URL;
  keywords?: string;
}

const {
  title,
  description = 'Evalúa la madurez de tu gobernanza de datos con DataCompass. Modelo CMMI, diagnóstico ejecutivo y hoja de ruta estratégica.',
  image = '/og-image.svg',
  canonicalURL = new URL(Astro.url.pathname, Astro.site),
  keywords = 'diagnóstico madurez datos, evaluación CMMI datos, data governance assessment, gobernanza de datos, madurez de datos empresas, CMMI data management, diagnóstico gobierno de datos, calidad de datos evaluación, data maturity model, informe ejecutivo datos, data strategy assessment gratuito, evaluación datos LATAM'
} = Astro.props;

const siteURL = Astro.site || new URL('https://data-compass-app.web.app');
const fullImageURL = new URL(image, siteURL);
const fullCanonicalURL = new URL(canonicalURL.pathname, siteURL);
---

<title>{title}</title>

<!-- Primary Meta Tags -->
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<meta name="theme-color" content="#0f172a" />
<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

<!-- Canonical URL -->
<link rel="canonical" href={fullCanonicalURL} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={fullCanonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullImageURL} />
<meta property="og:locale" content="es_ES" />
<meta property="og:site_name" content="DataCompass" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={fullCanonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullImageURL} />

<!-- LinkedIn specific -->
<meta property="linkedin:owner" content="DataCompass" />

<!-- JSON-LD Schema: SoftwareApplication -->
<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "DataCompass",
  "description": "Herramienta gratuita de diagnóstico de madurez de datos basada en el modelo CMMI. Evalúa Gobierno, Calidad, Arquitectura, Metadatos y Cultura de Datos en 10 minutos. Informe ejecutivo y recomendación estratégica.",
  "url": "https://data-compass-app.web.app",
  "image": "https://data-compass-app.web.app/og-image.svg",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web-based",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock"
  },
  "author": {
    "@type": "Organization",
    "name": "DataCompass",
    "url": "https://data-compass-app.web.app"
  },
  "softwareVersion": "1.0",
  "inLanguage": ["es-ES", "en-US"],
  "featureList": [
    "Diagnóstico de madurez de datos CMMI gratuito",
    "Evaluación en 5 dominios: Gobierno, Calidad, Arquitectura, Metadatos, Cultura",
    "Informe ejecutivo en menos de 10 minutos",
    "Radar chart de madurez por dominio",
    "Recomendación estratégica personalizada",
    "Descarga de informe en PDF sin registro previo"
  ],
  "screenshot": "https://data-compass-app.web.app/og-image.svg",
  "releaseNotes": "Versión 1.0 con evaluación completa"
}
</script>