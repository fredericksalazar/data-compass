---
import Layout from '../layouts/Layout.astro';
---

<Layout title="DataCompass - Evaluación de Madurez en Gobernanza de Datos">
  <main class="min-h-screen flex flex-col items-center justify-center px-4 py-16">
    <div class="max-w-3xl text-center">
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 mb-6">
        Governance de Datos para tu Organización
      </h1>
      <p class="text-base text-slate-600 leading-relaxed mb-8">
        Evalúa la madurez de tu gobernanza de datos con nuestra herramienta profesional. 
        Obtén insights accionables para mejorar la calidad y gestión de tus datos corporativos.
      </p>
      <a 
        href="/evaluacion"
        class="inline-flex justify-center rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-700 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
      >
        Iniciar Evaluación Gratuita
      </a>
    </div>
  </main>
</Layout>