---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="DataCompass — Diagnóstico de Madurez de Datos CMMI | Gratis en 10 minutos"
  description="Descubre en 10 minutos el nivel de madurez de datos de tu organización. Evaluación CMMI gratuita en 5 dominios: Gobierno de Datos, Calidad, Arquitectura, Metadatos y Cultura. Informe ejecutivo con recomendación estratégica. Sin registro previo."
  image="/og-datacompass.png"
  bodyClass="bg-slate-950">

  <style is:global>
    html { scroll-behavior: smooth; }

    #navbar.scrolled {
      background-color: rgb(2 6 23 / 0.95);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid rgb(30 41 59);
      box-shadow: 0 4px 24px rgb(0 0 0 / 0.4);
    }

    #hero-canvas { display: block; }

    @keyframes bounce-gentle {
      0%, 100% { transform: translateY(0); }
      50%       { transform: translateY(7px); }
    }
    #scroll-hint { transition: opacity 0.5s; }
    #scroll-hint.hidden-hint { opacity: 0; pointer-events: none; }
    #scroll-hint svg { animation: bounce-gentle 1.8s ease-in-out infinite; }

    @keyframes pulse-dot {
      0%, 100% { opacity: 1; }
      50%       { opacity: 0.4; }
    }
    .pulse-dot { animation: pulse-dot 2s ease-in-out infinite; }
  </style>

  <!-- ═══════════════════════════════════════════════
       NAVIGATION
  ════════════════════════════════════════════════ -->
  <nav id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 h-16 flex items-center justify-between">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5" aria-label="Volver a inicio - DataCompass">
        <svg class="h-7 w-7 text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9"/>
          <line x1="12" y1="3" x2="12" y2="21"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <polyline points="16.5 7.5 12 12 7.5 16.5" stroke-width="2"/>
        </svg>
        <span class="text-xl font-bold text-white tracking-tight">Data<span class="text-blue-400">Compass</span></span>
      </a>

      <!-- Desktop links -->
      <div class="hidden md:flex items-center gap-8">
        <a href="#dominios" class="text-sm text-slate-300 hover:text-white transition-colors">Dominios</a>
        <a href="#dominios"      class="text-sm text-slate-300 hover:text-white transition-colors">Dominios</a>
        <a href="/evaluacion"
           class="inline-flex justify-center rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-700 transition-colors">
          Iniciar Evaluación
        </a>
      </div>

      <!-- Mobile CTA -->
      <a href="/evaluacion"
         class="md:hidden inline-flex justify-center rounded-md bg-blue-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-blue-700 transition-colors">
        Evaluar
      </a>
    </div>
  </nav>

  <!-- ═══════════════════════════════════════════════
       HERO — DARK + 3D CANVAS
  ════════════════════════════════════════════════ -->
  <section class="relative min-h-screen flex flex-col items-center justify-center overflow-hidden bg-slate-950">
    <canvas id="hero-canvas" class="absolute inset-0 w-full h-full" aria-hidden="true"></canvas>

    <!-- Radial vignette overlay -->
    <div class="absolute inset-0 bg-radial-[at_50%_50%] from-transparent via-transparent to-slate-950/80 pointer-events-none"></div>

    <!-- Content -->
    <div class="relative z-10 text-center px-6 max-w-4xl mx-auto pt-16">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 rounded-full border border-blue-500/30 bg-blue-500/10 px-4 py-1.5 text-sm text-blue-300 mb-8" role="complementary" aria-label="Tipo de evaluación">
        <span class="pulse-dot h-1.5 w-1.5 rounded-full bg-blue-400" aria-hidden="true"></span>
        Evaluación CMMI &middot; Gobernanza de Datos
      </div>

      <!-- Headline -->
      <h1 class="text-5xl md:text-7xl font-bold tracking-tight text-white leading-tight mb-6">
        Evaluación de Madurez de Datos<br>
        <span class="bg-gradient-to-r from-blue-400 to-cyan-300 bg-clip-text text-transparent">
          basada en modelo CMMI
        </span>
      </h1>

      <!-- Subline -->
      <p class="text-lg md:text-xl text-slate-300 leading-relaxed max-w-2xl mx-auto mb-10">
        DataCompass evalúa tu organización según el modelo CMMI en 5 dominios críticos
        de gobernanza. En menos de 10 minutos obtienes un diagnóstico ejecutivo con tu
        hoja de ruta de mejora.
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/evaluacion"
           class="inline-flex justify-center rounded-md bg-blue-600 px-7 py-3 text-base font-semibold text-white shadow-lg hover:bg-blue-700 transition-colors">
          Iniciar Evaluación Gratuita &rarr;
        </a>
        <a href="#dominios"
           class="inline-flex justify-center rounded-md border border-slate-600 bg-slate-800/50 px-7 py-3 text-base font-semibold text-slate-200 hover:bg-slate-700/50 transition-colors">
          Ver los dominios
        </a>
      </div>
    </div>

    <!-- Scroll hint -->
    <div id="scroll-hint" class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-slate-500" aria-hidden="true">
      <span class="text-xs tracking-widest uppercase">Explorar</span>
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M6 9l6 6 6-6"/>
      </svg>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       STATS STRIP
  ════════════════════════════════════════════════ -->
  <section class="bg-slate-900 border-y border-slate-800 py-12">
    <div class="max-w-7xl mx-auto px-6 grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
      <div>
        <div class="text-4xl font-bold text-blue-400 mb-1">25</div>
        <div class="text-sm text-slate-400">Preguntas estructuradas</div>
      </div>
      <div>
        <div class="text-4xl font-bold text-blue-400 mb-1">5</div>
        <div class="text-sm text-slate-400">Dominios CMMI evaluados</div>
      </div>
      <div>
        <div class="text-4xl font-bold text-blue-400 mb-1">&lt;10</div>
        <div class="text-sm text-slate-400">Minutos de respuesta</div>
      </div>
      <div>
        <div class="text-4xl font-bold text-blue-400 mb-1">100%</div>
        <div class="text-sm text-slate-400">Gratuito y sin compromiso</div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       PRODUCT PREVIEW — alternating rows
  ════════════════════════════════════════════════ -->
  <section class="py-28 bg-slate-950 overflow-hidden">
    <div class="max-w-6xl mx-auto px-6">

      <!-- Header -->
      <div class="text-center mb-20">
        <div class="inline-flex items-center gap-2 rounded-full border border-blue-500/30 bg-blue-500/10 px-4 py-1.5 text-sm text-blue-300 mb-5">
          <span class="h-1.5 w-1.5 rounded-full bg-blue-400 animate-pulse"></span>
          Resultado real · Sin registro previo
        </div>
        <h2 class="text-3xl lg:text-4xl font-bold text-white mb-4 leading-tight">
          Así se ve tu informe al finalizar
        </h2>
        <p class="text-slate-400 text-lg max-w-xl mx-auto leading-relaxed">
          Ejecutivo, visual y listo para llevar a dirección.
        </p>
      </div>

      <!-- Row 1 — imagen izquierda, texto derecha -->
      <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-16 mb-24 lg:mb-32">
        <!-- Image -->
        <div class="w-full lg:w-3/5 flex-shrink-0">
          <div class="rounded-2xl border border-slate-700/60 bg-slate-900 overflow-hidden shadow-2xl shadow-blue-950/20">
            <div class="flex items-center gap-1.5 px-4 py-2.5 bg-slate-800/80 border-b border-slate-700/50">
              <span class="h-2.5 w-2.5 rounded-full bg-red-500/70"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-yellow-500/70"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-green-500/70"></span>
              <span class="ml-3 text-xs text-slate-500">data-compass-app.web.app</span>
            </div>
            <img
              src="/screenshots/dashboard-score.png"
              alt="Dashboard de puntuación global con gauge circular, nivel CMMI y radar chart por dominio"
              class="w-full object-cover object-top"
              loading="lazy"
            />
          </div>
        </div>
        <!-- Text -->
        <div class="w-full lg:w-2/5">
          <p class="text-xs font-bold tracking-[0.2em] text-blue-400 uppercase mb-3">01 — Dashboard</p>
          <h3 class="text-2xl lg:text-3xl font-bold text-white mb-4 leading-snug">
            Tu madurez de datos en una sola pantalla
          </h3>
          <p class="text-slate-400 leading-relaxed mb-6">
            Score global de 0 a 5, nivel CMMI asignado automáticamente y radar chart por dominio. Todo generado en segundos a partir de tus respuestas — sin análisis manual.
          </p>
          <ul class="space-y-3">
            {[
              ['Gauge circular', 'Puntuación global instantánea con color semafórico'],
              ['Radar por dominio', 'Perfil visual de los 5 dominios CMMI evaluados'],
              ['Nivel automático', 'Clasificación CMMI de Inicial a Optimizado'],
            ].map(([bold, desc]) => (
              <li class="flex items-start gap-3">
                <div class="mt-0.5 h-5 w-5 rounded-full bg-blue-500/15 border border-blue-500/30 flex items-center justify-center flex-shrink-0">
                  <svg class="h-3 w-3 text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                    <path d="M20 6L9 17l-5-5"/>
                  </svg>
                </div>
                <span class="text-sm text-slate-400"><span class="text-slate-200 font-medium">{bold}.</span> {desc}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Row 2 — texto izquierda, imagen derecha -->
      <div class="flex flex-col-reverse lg:flex-row items-center gap-12 lg:gap-16 mb-24 lg:mb-32">
        <!-- Text -->
        <div class="w-full lg:w-2/5">
          <p class="text-xs font-bold tracking-[0.2em] text-green-400 uppercase mb-3">02 — Roadmap</p>
          <h3 class="text-2xl lg:text-3xl font-bold text-white mb-4 leading-snug">
            Sabe exactamente dónde estás y qué viene después
          </h3>
          <p class="text-slate-400 leading-relaxed mb-6">
            Visualización de los 5 niveles del modelo CMMI con tu posición actual destacada, el contexto de lo que significa ese nivel y el próximo horizonte estratégico.
          </p>
          <ul class="space-y-3">
            {[
              ['Progresión visual', 'Los 5 niveles del modelo representados como escalera de madurez'],
              ['Posición actual', 'Tu nivel resaltado con pin animado y descripción contextual'],
              ['Próximo paso', 'Descripción clara de qué implica el siguiente nivel'],
            ].map(([bold, desc]) => (
              <li class="flex items-start gap-3">
                <div class="mt-0.5 h-5 w-5 rounded-full bg-green-500/15 border border-green-500/30 flex items-center justify-center flex-shrink-0">
                  <svg class="h-3 w-3 text-green-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                    <path d="M20 6L9 17l-5-5"/>
                  </svg>
                </div>
                <span class="text-sm text-slate-400"><span class="text-slate-200 font-medium">{bold}.</span> {desc}</span>
              </li>
            ))}
          </ul>
        </div>
        <!-- Image -->
        <div class="w-full lg:w-3/5 flex-shrink-0">
          <div class="rounded-2xl border border-slate-700/60 bg-slate-900 overflow-hidden shadow-2xl shadow-green-950/10">
            <div class="flex items-center gap-1.5 px-4 py-2.5 bg-slate-800/80 border-b border-slate-700/50">
              <span class="h-2.5 w-2.5 rounded-full bg-red-500/70"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-yellow-500/70"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-green-500/70"></span>
              <span class="ml-3 text-xs text-slate-500">data-compass-app.web.app</span>
            </div>
            <img
              src="/screenshots/cmmi-roadmap.png"
              alt="Roadmap CMMI con los 5 niveles de madurez y posición actual destacada"
              class="w-full object-cover object-top"
              loading="lazy"
            />
          </div>
        </div>
      </div>

      <!-- Row 3 — imagen izquierda, texto derecha -->
      <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-16">
        <!-- Image -->
        <div class="w-full lg:w-3/5 flex-shrink-0">
          <div class="rounded-2xl border border-slate-700/60 bg-slate-900 overflow-hidden shadow-2xl shadow-cyan-950/10">
            <div class="flex items-center gap-1.5 px-4 py-2.5 bg-slate-800/80 border-b border-slate-700/50">
              <span class="h-2.5 w-2.5 rounded-full bg-red-500/70"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-yellow-500/70"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-green-500/70"></span>
              <span class="ml-3 text-xs text-slate-500">data-compass-app.web.app</span>
            </div>
            <img
              src="/screenshots/executive-summary.png"
              alt="Resumen ejecutivo con análisis por dominio, fortalezas, brechas y recomendación estratégica"
              class="w-full object-cover object-top"
              loading="lazy"
            />
          </div>
        </div>
        <!-- Text -->
        <div class="w-full lg:w-2/5">
          <p class="text-xs font-bold tracking-[0.2em] text-cyan-400 uppercase mb-3">03 — Resumen ejecutivo</p>
          <h3 class="text-2xl lg:text-3xl font-bold text-white mb-4 leading-snug">
            Diagnóstico accionable, no solo métricas
          </h3>
          <p class="text-slate-400 leading-relaxed mb-6">
            Fortalezas, brechas críticas y recomendación estratégica personalizada. Listo para presentar a dirección sin necesitar un consultor que lo traduzca.
          </p>
          <ul class="space-y-3">
            {[
              ['Análisis por dominio', 'Insight accionable para cada uno de los 5 dominios'],
              ['Fortaleza y brecha', 'Qué tienes consolidado y qué necesita atención inmediata'],
              ['Recomendación estratégica', 'Próximo paso priorizado según el perfil de madurez'],
            ].map(([bold, desc]) => (
              <li class="flex items-start gap-3">
                <div class="mt-0.5 h-5 w-5 rounded-full bg-cyan-500/15 border border-cyan-500/30 flex items-center justify-center flex-shrink-0">
                  <svg class="h-3 w-3 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                    <path d="M20 6L9 17l-5-5"/>
                  </svg>
                </div>
                <span class="text-sm text-slate-400"><span class="text-slate-200 font-medium">{bold}.</span> {desc}</span>
              </li>
            ))}
          </ul>
          <!-- CTA inline -->
          <div class="mt-8">
            <a
              href="/evaluacion"
              class="inline-flex items-center gap-2 rounded-xl bg-blue-600 hover:bg-blue-500 px-6 py-3 text-sm font-semibold text-white transition-all shadow-lg shadow-blue-900/30"
            >
              Obtener mi diagnóstico gratis
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       PROBLEMA
  ════════════════════════════════════════════════ -->
  <section class="py-24 bg-slate-950">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-16">
        <div class="inline-block rounded-full bg-amber-500/10 border border-amber-500/30 px-4 py-1.5 text-sm font-medium text-amber-400 mb-6">
          El problema
        </div>
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-6 leading-tight">
          ¿Sabes realmente cómo gestiona<br class="hidden md:block">
          tu organización sus datos?
        </h2>
        <p class="text-lg text-slate-400 leading-relaxed max-w-3xl mx-auto">
          La mayoría de las organizaciones creen tener el control de sus datos, pero sin un
          diagnóstico estructurado es imposible identificar los riesgos ocultos, los silos
          de información y las brechas de madurez que frenan la toma de decisiones basada en datos.
        </p>
      </div>

      <!-- Pain point cards -->
      <div class="grid md:grid-cols-3 gap-6">
        <!-- Card 1 -->
        <div class="rounded-xl border border-slate-800 bg-slate-900 p-8">
          <div class="h-12 w-12 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center mb-6" aria-hidden="true">
            <svg class="h-6 w-6 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <line x1="12" y1="8" x2="12" y2="12"/>
              <line x1="12" y1="16" x2="12.01" y2="16" stroke-width="2"/>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-white mb-3">Sin visibilidad</h3>
          <p class="text-slate-400 leading-relaxed text-sm">
            No sabes qué datos tienes, dónde están, ni quién es el responsable de ellos.
            Los activos de datos permanecen invisibles e incontrolados.
          </p>
        </div>
        <!-- Card 2 -->
        <div class="rounded-xl border border-slate-800 bg-slate-900 p-8">
          <div class="h-12 w-12 rounded-xl bg-red-500/10 border border-red-500/20 flex items-center justify-center mb-6" aria-hidden="true">
            <svg class="h-6 w-6 text-red-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
              <line x1="12" y1="9" x2="12" y2="13"/>
              <line x1="12" y1="17" x2="12.01" y2="17" stroke-width="2"/>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-white mb-3">Decisiones sin datos</h3>
          <p class="text-slate-400 leading-relaxed text-sm">
            Los equipos operan con intuición en lugar de información fiable y gobernada.
            La calidad del dato nunca está garantizada.
          </p>
        </div>
        <!-- Card 3 -->
        <div class="rounded-xl border border-slate-800 bg-slate-900 p-8">
          <div class="h-12 w-12 rounded-xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center mb-6" aria-hidden="true">
            <svg class="h-6 w-6 text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 2L3 6v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V6L12 2z"/>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-white mb-3">Riesgos regulatorios</h3>
          <p class="text-slate-400 leading-relaxed text-sm">
            La falta de control sobre datos sensibles expone a la organización a multas,
            auditorías y pérdida reputacional frente a clientes y reguladores.
          </p>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════
       DOMINIOS CMMI
  ════════════════════════════════════════════════ -->
  <section id="dominios" class="py-24 bg-slate-900">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-16">
        <div class="inline-block rounded-full bg-blue-500/10 border border-blue-500/30 px-4 py-1.5 text-sm font-medium text-blue-300 mb-4">
          Cobertura
        </div>
        <h2 class="text-4xl font-bold text-white mb-4">
          Los 5 dominios del modelo CMMI evaluados
        </h2>
        <p class="text-lg text-slate-400 max-w-2xl mx-auto">
          Cobertura completa de las dimensiones que determinan la madurez real
          de tu organización en gobernanza de datos.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        <!-- Gobierno de Datos -->
        <div class="rounded-xl border border-slate-700 bg-slate-800/60 p-6 text-center hover:border-blue-500/50 hover:bg-slate-800 transition-all duration-200 group">
          <div class="h-12 w-12 rounded-xl bg-blue-500/10 border border-blue-500/20 group-hover:border-blue-500/40 flex items-center justify-center mx-auto mb-4 transition-all duration-200">
            <svg class="h-6 w-6 text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2L3 6v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V6L12 2z"/>
            </svg>
          </div>
          <h3 class="text-sm font-semibold text-white mb-2">Gobierno de Datos</h3>
          <p class="text-xs text-slate-500 leading-relaxed">Políticas, roles, responsabilidades y marcos de decisión.</p>
        </div>

        <!-- Calidad de Datos -->
        <div class="rounded-xl border border-slate-700 bg-slate-800/60 p-6 text-center hover:border-blue-500/50 hover:bg-slate-800 transition-all duration-200 group">
          <div class="h-12 w-12 rounded-xl bg-blue-500/10 border border-blue-500/20 group-hover:border-blue-500/40 flex items-center justify-center mx-auto mb-4 transition-all duration-200">
            <svg class="h-6 w-6 text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 11-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
          </div>
          <h3 class="text-sm font-semibold text-white mb-2">Calidad de Datos</h3>
          <p class="text-xs text-slate-500 leading-relaxed">Estándares y controles de precisión, completitud y consistencia.</p>
        </div>

        <!-- Arquitectura de Datos -->
